{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "web/src/types/screp-js.d.ts", "web/src/utils/replayParser.ts", "web/src/utils/replayMemberMatch.ts", "web/src/constants/*.ts", "web/src/types/index.ts"]
}
