diff --git a/tests/test_app_login.py b/tests/test_app_login.py
new file mode 100644
index 0000000..5cc1c7a
--- /dev/null
+++ b/tests/test_app_login.py
@@ -0,0 +1,42 @@
+"""앱(자동 등록기) 로그인 — 아이디·비밀번호로 장기 토큰 하나를 받고, 그 토큰이 그대로
+Bearer로 통해야 한다(리프레시 없음). 만료는 설정(app_token_expire_days)만큼 길다."""
+
+from datetime import UTC, datetime, timedelta
+
+from app.core.config import settings
+from app.core.security import decode_access_token
+
+
+async def _signup(client, member_id: str, battletag: str) -> dict:
+    res = await client.post(
+        "/api/auth/signup",
+        json={"id": member_id, "password": "pass1234", "battletag": battletag,
+              "replayAliases": [member_id], "insta": ""},
+    )
+    assert res.status_code == 200, res.text
+    return res.json()
+
+
+async def test_app_login_issues_long_lived_bearer(client):
+    a = await _signup(client, "alice", "Alice#1001")
+    res = await client.post(
+        "/api/auth/app-login", json={"id": "alice", "password": "pass1234", "device": "PC-1"}
+    )
+    assert res.status_code == 200, res.text
+    body = res.json()
+    assert body["user"]["id"] == a["user"]["id"]
+    assert "refreshToken" not in body
+    assert decode_access_token(body["appToken"]).isdigit()  # sub = 회원 pk
+    expires = datetime.fromisoformat(body["expiresAt"].replace("Z", "+00:00"))
+    days = (expires - datetime.now(UTC)) / timedelta(days=1)
+    assert settings.app_token_expire_days - 1 < days <= settings.app_token_expire_days
+
+    me = await client.get("/api/auth/me", headers={"Authorization": f"Bearer {body['appToken']}"})
+    assert me.status_code == 200, me.text
+    assert me.json()["id"] == a["user"]["id"]
+
+
+async def test_app_login_rejects_wrong_password(client):
+    await _signup(client, "alice", "Alice#1001")
+    res = await client.post("/api/auth/app-login", json={"id": "alice", "password": "nope"})
+    assert res.status_code == 401
