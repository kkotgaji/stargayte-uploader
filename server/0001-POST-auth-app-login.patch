--- a/src/app/core/security.py
+++ b/src/app/core/security.py
@@ -26,6 +26,14 @@ def create_access_token(subject: str) -> str:
     return jwt.encode(payload, settings.jwt_secret_key, algorithm=settings.jwt_algorithm)
 
 
+def create_app_token(subject: str) -> tuple[str, datetime]:
+    """앱(자동 등록기)용 장기 액세스 토큰 — 만료가 길 뿐 decode_access_token이 그대로 읽는다.
+    `kind: app`을 실어 두어 접속 기록·차단에 갈래를 남길 수 있다."""
+    expires_at = datetime.now(UTC) + timedelta(days=settings.app_token_expire_days)
+    payload = {"sub": subject, "exp": expires_at, "kind": "app"}
+    return jwt.encode(payload, settings.jwt_secret_key, algorithm=settings.jwt_algorithm), expires_at
+
+
 def decode_access_token(token: str) -> str:
     try:
         payload = jwt.decode(token, settings.jwt_secret_key, algorithms=[settings.jwt_algorithm])
